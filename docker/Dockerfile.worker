# ===================== Worker 镜像 =====================
# Worker 用 tsx 直接运行 TypeScript 源码，与 Web 共享同一份代码与数据卷
FROM node:24-slim

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@12.4.1 --activate || npm i -g pnpm@12.4.1

# ffmpeg（渲染编码）+ 无头浏览器运行时依赖（Vibe 模式逐帧渲染）
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/pipeline/package.json packages/pipeline/
# 保留 web 的清单以维持 workspace 形态（--frozen-lockfile 校验需要），但不会安装它的依赖
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/

# 只装 worker 及其工作区依赖（@sakura/core / db / pipeline + zod + tsx）。
# 不装 web 的前端栈（next / react / @xyflow/react / tailwind 等），省下数百 MB。
RUN pnpm install --frozen-lockfile --filter @sakura/worker...

# 构建期安装浏览器、运行库与中文字体；运行时不下载任何组件。
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN cd apps/worker && pnpm exec playwright install --with-deps --only-shell chromium \
  && apt-get install -y --no-install-recommends fonts-noto-cjk \
  && chmod -R a+rX /opt/ms-playwright \
  && rm -rf /var/lib/apt/lists/*

COPY tsconfig.base.json ./
COPY packages packages
COPY apps/worker apps/worker

ENV NODE_ENV=production \
    SAKURA_DATA_DIR=/data \
    FFMPEG_PATH=ffmpeg \
    WORKER_CONCURRENCY=3

RUN mkdir -p /data
VOLUME ["/data"]

WORKDIR /app/apps/worker
CMD ["./node_modules/.bin/tsx", "src/index.ts"]
