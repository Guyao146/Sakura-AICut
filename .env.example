# ================= Sakura AI Cut 环境变量 =================
# 复制为 .env 后按需修改；所有变量都有合理默认值，可全部留空直接运行。

# 数据目录：SQLite 数据库 / 上传素材 / 生成产物 / 渲染结果
SAKURA_DATA_DIR=./data

# 服务对外地址（用于回调与绝对链接）
APP_URL=http://localhost:3000
PORT=3000

# 加密密钥：用于加密保存供应商 API Key（生产环境务必修改，长度 >= 32）
SAKURA_SECRET=sakura-aicut-change-me-please-32chars

# Worker：并发执行的模型任务数量 / 轮询间隔(ms)
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL=1500

# ffmpeg 可执行文件路径（Docker 镜像内已内置为 ffmpeg）
FFMPEG_PATH=ffmpeg

# Vibe 模式（主题直出）：无声动画与字幕，24 fps，上限 150 秒 / 3600 帧。
# 容器内置浏览器及字体，并使用 docker/render-seccomp.json 允许嵌套沙箱；不可加 --no-sandbox。
# 本地开发首次使用执行：pnpm --filter @sakura/worker exec playwright install --only-shell chromium
# Linux 本地运行还需安装系统依赖，并允许非特权用户命名空间。
# PLAYWRIGHT_BROWSERS_PATH 仅在使用自定义缓存目录时设置，默认无需配置。

# 单次生成任务超时（秒）与异步任务最大轮询时长（秒）
JOB_TIMEOUT=600
ASYNC_TASK_TIMEOUT=1800

# 开放 API（/api/open/*）：可选静态 Key，逗号分隔多个值。
# 也可在「设置 → 生态授权」生成配对码；动态授权不依赖此变量。
# 没有有效静态或动态凭证时返回 401。配对撤销不影响这里的静态 Key。
# 动态 screenplay:import 默认关闭，需在生态授权单独开启；既有授权可开关，无需重配对。
# 静态 Key 保持全局权限，可导入剧本草稿；接口拒绝覆盖已有剧本，且不会自动生成或渲染。
# 剧本端点：POST /api/open/projects/[id]/screenplay，必须携带 Idempotency-Key。
AICUT_OPEN_API_KEYS=
